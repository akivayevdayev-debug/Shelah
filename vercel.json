{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
        "api/index.py": {
            "maxDuration": 90
        }
    },
    "regions": ["iad1"],
    "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)*.md' ':(exclude)docs/**'",
    "redirects": [
        {
            "source": "/:path((?!api/devtools/).*)",
            "has": [
                {
                    "type": "host",
                    "value": "(shelah-app|shelah-akivayevdayev-debugs-projects|shelah-git-main-akivayevdayev-debugs-projects)\\.vercel\\.app"
                }
            ],
            "destination": "https://shelah.org/:path",
            "permanent": true
        }
    ],
    "crons": [
        {
            "path": "/api/devtools/budget-check",
            "schedule": "0 13 * * *"
        },
        {
            "path": "/api/devtools/retention-enforce",
            "schedule": "0 14 * * *"
        }
    ],
    "headers": [
        {
            "source": "/static/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600"
                }
            ]
        }
    ]
}
