{
  "name": "sh'elah_app",
  "version": "1.0.0",
  "description": "Sh'elah build tooling (Tailwind CSS)",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "node --test tests_js/*.test.js",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include=static/** --test-coverage-include=sentry-discord-relay/src/** --test-coverage-include=scripts/a11y_dark_scan.js --test-coverage-include=scripts/build_*.mjs --test-coverage-include=tests_js/** --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.raw.info tests_js/*.test.js && python3 scripts/merge_lcov.py < coverage/lcov.raw.info > coverage/lcov.info",
    "build:css": "tailwindcss -i ./static/css/tailwind.input.css -o ./static/css/tailwind.css --minify",
    "build:assets": "node scripts/build_assets.mjs",
    "build:critical": "node scripts/build_critical_css.mjs",
    "check:assets": "node scripts/build_assets.mjs --check",
    "test:a11y": "npm run test:a11y:light && npm run test:a11y:dark",
    "test:a11y:light": "pa11y-ci --config .pa11yci.json",
    "test:a11y:dark": "node scripts/a11y_dark_scan.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akivayevdayev-debug/Shelah.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/akivayevdayev-debug/Shelah/issues"
  },
  "homepage": "https://github.com/akivayevdayev-debug/Shelah#readme",
  "devDependencies": {
    "@sentry/browser": "^11.9.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "pa11y-ci": "^5.0.0",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "@parcel/watcher": "^2.6.0",
    "pa11y": "^10.0.0",
    "puppeteer": "^25.16.0",
    "postcss-selector-parser": "^7.1.7"
  }
}
